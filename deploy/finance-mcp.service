[Unit]
Description=Finance MCP server
Wants=network-online.target
After=network-online.target

[Service]
User=finance-mcp
EnvironmentFile=/etc/finance-mcp.env
# xvfb-run gives the browser a virtual display and sets DISPLAY
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1920x1080x24" /usr/local/bin/finance-mcp
Restart=on-failure

[Install]
WantedBy=multi-user.target
